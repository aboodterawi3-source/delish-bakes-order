# ==============================================================================
# DELISH CAKE & BAKE — PRODUCTION ENVIRONMENT CONFIGURATION
# Amman, Jordan (Asia/Amman)
# Copy this file to .env and replace placeholder values with your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Project Configuration (From your Supabase Project Settings -> API)
# ------------------------------------------------------------------------------
# Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Project Ref / ID
SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# Supabase Publishable / Anon Key (Safe for client browsers)
SUPABASE_PUBLISHABLE_KEY="sb_publishable_or_anon_key_here"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_or_anon_key_here"

# Supabase Service Role Secret Key (KEEP PRIVATE! Used only by server-side functions)
# Found in: Supabase Dashboard -> Project Settings -> API -> service_role secret
SUPABASE_SERVICE_ROLE_KEY="sb_secret_service_role_key_here"

# ------------------------------------------------------------------------------
# 2. Public Site & Application URLs
# ------------------------------------------------------------------------------
# Production public URL of your application (Used for generating WhatsApp customer edit links)
PUBLIC_SITE_URL="https://your-bakery-domain.com"
VITE_SITE_URL="https://your-bakery-domain.com"

# ------------------------------------------------------------------------------
# 3. Independent Hosting Build Targets (Optional Nitro Preset)
# ------------------------------------------------------------------------------
# If deploying to Vercel, Netlify, Node server or Cloudflare, you can specify:
# NITRO_PRESET="node-server" # For standard Node.js Docker or VPS container
# NITRO_PRESET="vercel"      # For Vercel Edge/Serverless deployment
# NITRO_PRESET="netlify"     # For Netlify Serverless deployment
